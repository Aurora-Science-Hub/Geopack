# NativeAOT build outputs (regenerated by deploy/build_native.sh)
out/

# Wheels (regenerated by deploy/build_wheel.sh)
dist/

# Python build artifacts
python/build/
python/dist/
python/*.egg-info/

# Native library copied into the package by build_wheel.sh
python/geopack/*.dylib
python/geopack/*.so
python/geopack/*.dll

# Python caches
__pycache__/
*.pyc
