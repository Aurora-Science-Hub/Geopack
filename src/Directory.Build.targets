<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    PackageReleaseNotes contains only the CHANGELOG.md section of the version
    being packed; the full history stays in CHANGELOG.md. The static link in
    Directory.Build.props is only a fallback when the changelog is unavailable.
  -->
  <Target Name="SetPackageReleaseNotesFromChangelog"
          BeforeTargets="GenerateNuspec"
          Condition="Exists('$(MSBuildThisFileDirectory)../CHANGELOG.md')">
    <PropertyGroup>
      <_ChangelogPath>$(MSBuildThisFileDirectory)../CHANGELOG.md</_ChangelogPath>
      <_ChangelogVersionPattern>$(PackageBaseVersion.Replace('.', '[.]'))</_ChangelogVersionPattern>
      <_ChangelogText>$([System.IO.File]::ReadAllText('$(_ChangelogPath)'))</_ChangelogText>
      <_ReleaseNotes>$([System.Text.RegularExpressions.Regex]::Match($(_ChangelogText), '(?ms)^## \[$(_ChangelogVersionPattern)\].*?(?=^## \[|\z)').Value.Trim())</_ReleaseNotes>
    </PropertyGroup>

    <Error Condition="'$(_ReleaseNotes)' == ''"
           Text="CHANGELOG.md has no '## [$(PackageBaseVersion)]' section. Add it before packing." />

    <PropertyGroup>
      <PackageReleaseNotes>$(_ReleaseNotes)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

</Project>
