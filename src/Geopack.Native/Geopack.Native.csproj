<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT export layer for Geopack.
    Builds a C-compatible shared library (libgeopack.dylib / libgeopack.so / geopack.dll)
    loadable from Python via ctypes without a .NET runtime on the target machine.
    This project is intentionally NOT part of Geopack.slnx: CI builds/packs the solution,
    and AOT publish is only performed locally by deploy/build_native.sh.
  -->

  <PropertyGroup>
    <!-- Single TFM. Must also clear the inherited TargetFrameworks list from the root
         Directory.Build.props, otherwise the plural property wins and the project
         silently multi-targets, which breaks NativeAOT publishing. -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>geopack</AssemblyName>
    <RootNamespace>AuroraScienceHub.Geopack.Native</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Not a NuGet package: build-time AOT layer only -->
    <IsPackable>false</IsPackable>

    <!-- Produce a shared library instead of an executable. PublishAot/IsAotCompatible come from src/Directory.Build.props -->
    <NativeLib>Shared</NativeLib>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geopack\Geopack.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
